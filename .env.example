# Artits — environment declarations
#
# Copy to `.env` (never commit it — `.gitignore` covers `.env` and `.env.*`).
# Artits has NO build-time Vite variables: `src/` reads no `import.meta.env.*`.
# Everything below is either a CI secret or a Cloudflare Pages binding, so nothing
# here needs to exist for `npm run build` to succeed.
#
# The deploy that actually runs is Cloudflare Pages (`.github/workflows/deploy.yml`),
# which reads its two credentials from GitHub Actions secrets, not from this file.

# --- CI (GitHub Actions secrets; used by .github/workflows/deploy.yml) ---------
# Cloudflare account that owns the Pages project. Set as a repo secret named
# CLOUDFLARE_ACCOUNT_ID. Replace with your own account id; never put the token here.
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
# Cloudflare API token with "Cloudflare Pages: Edit" on that account. GitHub secret
# CLOUDFLARE_API_TOKEN. Leave blank here.
CLOUDFLARE_API_TOKEN=

# --- Cloudflare Pages Function bindings ---------------------------------------
# functions/api/memories.ts reads and writes the KV namespace bound to this Pages
# project as `MEMORIES_KV`. A KV binding is NOT an environment variable: it is set
# in the Cloudflare dashboard (Workers & Pages -> project-app-artits -> Settings ->
# Functions -> KV namespace bindings), or per-wrangler.toml `[[kv_namespaces]]`.
#
# A real namespace id is deliberately NOT written into wrangler.toml — a placeholder
# id there breaks `wrangler pages deploy`. Until the binding is created the endpoint
# returns HTTP 503 with `{"error":"MEMORIES_KV is not configured: ..."}` rather than
# crashing.
# MEMORIES_KV_ID=

# --- CDN publisher (ci/upload_to_hf.py, run from Jenkins) ---------------------
# Hugging Face write token with access to the `rttss/ota-patches` dataset. Only
# needed on the machine that publishes (Jenkins), never in the Pages build.
HF_TOKEN=
# HF_TOKEN_ORG=

# --- Local only ---------------------------------------------------------------
# Override the Vite dev port if 5173 is taken: `npx vite --port 5174`
# ARTITS_DEV_PORT=5173
